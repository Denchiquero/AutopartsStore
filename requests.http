Content-Type: application/json

{
"id": 3,
"name": "Bosch front brake pads",
"sku": "BOSCH-BP-001",
"article": "0986494127",
"description": "Updated description",
"price": 4500.00,
"manufacturerId": 2,
"categoryId": 3
}

